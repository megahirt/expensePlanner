{
  "manifest_version": 3,
  "name": "expensePlanner",
  "version": "0.0.0",
  "description": "Browse your expenses across Amazon, bank and credit card sources. All data stays on this computer.",
  "minimum_chrome_version": "110",
  "action": { "default_title": "Open expensePlanner" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "optional_host_permissions": ["https://www.amazon.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
